{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gald33/lucille-host/blob/main/src/lucille_host/spec/v1/request.schema.json",
  "title": "lucille.exec/1 request",
  "description": "A request from Lucille to the host: the sealed body of one Switchboard message of type note, with no thread, on the channel lucille.exec of a work room. One branch per operation; each is a closed object. spec/PROTOCOL.md holds the rules this schema cannot express.",
  "oneOf": [
    {
      "$ref": "#/$defs/request.host.describe"
    },
    {
      "$ref": "#/$defs/request.host.sleep"
    },
    {
      "$ref": "#/$defs/request.files.sha256"
    },
    {
      "$ref": "#/$defs/request.files.search"
    },
    {
      "$ref": "#/$defs/request.github.read"
    },
    {
      "$ref": "#/$defs/request.gmail.check"
    },
    {
      "$ref": "#/$defs/request.gmail.mailboxes"
    },
    {
      "$ref": "#/$defs/request.gmail.search"
    },
    {
      "$ref": "#/$defs/request.gmail.read"
    }
  ],
  "$defs": {
    "v": {
      "description": "The protocol and its major version.",
      "const": "lucille.exec/1"
    },
    "dir": {
      "description": "Which way the message travels.",
      "type": "string",
      "enum": [
        "request",
        "reply"
      ]
    },
    "job_id": {
      "description": "Lucille's id for the job: a lowercase UUID in 8-4-4-4-12 form.",
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "op_name": {
      "description": "An operation name: namespaced, lowercase, at most 64 characters.",
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "root": {
      "description": "A folder alias from the host's local policy. Never a path.",
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "not_after": {
      "description": "When Lucille stops waiting: whole seconds since the Unix epoch, UTC. The host also refuses a value more than 86400 s after it received the request (PROTOCOL.md, rule not-after-range).",
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "cap": {
      "description": "A cap on one output stream, in bytes of its JSON-encoded string, quotes included (PROTOCOL.md, 'How size is measured'). At least 2: the empty stream measures 2 bytes.",
      "type": "integer",
      "minimum": 2,
      "maximum": 2147483647
    },
    "caps": {
      "description": "Caps Lucille asks for. For each stream of a child's output the host applies the lower of this and its own cap; a request's caps do not apply to the document host.describe returns (PROTOCOL.md section 11).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stdout_bytes",
        "stderr_bytes"
      ],
      "properties": {
        "stdout_bytes": {
          "$ref": "#/$defs/cap"
        },
        "stderr_bytes": {
          "$ref": "#/$defs/cap"
        }
      }
    },
    "min_host_version": {
      "description": "The oldest host release that may run this request: MAJOR.MINOR.PATCH, digits only, no suffix.",
      "type": "string",
      "minLength": 5,
      "maxLength": 32,
      "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})$"
    },
    "relative_path": {
      "description": "A path inside the root. Containment (no absolute path, no '..', realpath inside the root, nothing in the host's own folders, and no FIFO, socket or device) is checked by the host, not by this schema, and refused path_outside_root.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000]*$"
    },
    "args.host.describe": {
      "description": "host.describe takes no arguments.",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "args.host.sleep": {
      "description": "host.sleep: sleep n seconds. Diagnostic.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n"
      ],
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        }
      }
    },
    "args.files.sha256": {
      "description": "files.sha256: the SHA-256 digest of one file under a root.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "path"
      ],
      "properties": {
        "root": {
          "$ref": "#/$defs/root"
        },
        "path": {
          "$ref": "#/$defs/relative_path"
        }
      }
    },
    "args.files.search": {
      "description": "files.search: search the files under a root for a pattern.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "pattern",
        "fixed_strings",
        "max_count"
      ],
      "properties": {
        "root": {
          "$ref": "#/$defs/root"
        },
        "pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000]*$"
        },
        "fixed_strings": {
          "type": "boolean"
        },
        "max_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      }
    },
    "args.github.read": {
      "description": "github.read: read one GitHub REST API endpoint with a credential stored on the computer (spec/PROTOCOL.md section 10; decisions/0003).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential",
        "path"
      ],
      "properties": {
        "credential": {
          "description": "The credential's name; the host uses the one it stores as github/<credential>.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "path": {
          "description": "One of the listed GitHub read endpoints, with only the listed query keys.",
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^/(user|user/repos|search/issues|repos/[A-Za-z0-9][A-Za-z0-9-]{0,38}/([A-Za-z0-9_-][A-Za-z0-9._-]{0,99}|\\.[A-Za-z0-9_-][A-Za-z0-9._-]{0,98}|\\.\\.[A-Za-z0-9._-]{1,98})(/issues(/[1-9][0-9]{0,9}(/comments)?)?|/pulls(/[1-9][0-9]{0,9})?|/commits|/readme)?)(\\?(per_page=([1-9]|[1-9][0-9]|100)|page=[1-9][0-9]{0,4}|state=(open|closed|all)|sort=(created|updated|comments|pushed|full_name)|direction=(asc|desc)|q=[A-Za-z0-9%+:._-]{1,256})(&(per_page=([1-9]|[1-9][0-9]|100)|page=[1-9][0-9]{0,4}|state=(open|closed|all)|sort=(created|updated|comments|pushed|full_name)|direction=(asc|desc)|q=[A-Za-z0-9%+:._-]{1,256}))*)?$"
        }
      }
    },
    "args.gmail.check": {
      "description": "gmail.check: sign in to Gmail over IMAP with an app password stored on the computer, and out again; no message is read (spec/PROTOCOL.md section 10; decisions/0003).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential"
      ],
      "properties": {
        "credential": {
          "description": "The credential's name; the host uses the one it stores as gmail/<credential>.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        }
      }
    },
    "args.gmail.mailboxes": {
      "description": "gmail.mailboxes: the Gmail account's mailboxes, at most 500 (spec/PROTOCOL.md section 10; decisions/0003).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential"
      ],
      "properties": {
        "credential": {
          "description": "The credential's name; the host uses the one it stores as gmail/<credential>.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        }
      }
    },
    "args.gmail.search": {
      "description": "gmail.search: the newest messages of one mailbox that match every criterion given, read-only (spec/PROTOCOL.md section 10; decisions/0003).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential"
      ],
      "properties": {
        "credential": {
          "description": "The credential's name; the host uses the one it stores as gmail/<credential>.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "mailbox": {
          "description": "The mailbox to search, by its name as gmail.mailboxes gives it; INBOX when not given.",
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000]*$"
        },
        "query": {
          "description": "Gmail's own search syntax, sent as X-GM-RAW.",
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000]*$"
        },
        "from": {
          "description": "Matches the From header.",
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000]*$"
        },
        "to": {
          "description": "Matches the To header.",
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000]*$"
        },
        "subject": {
          "description": "Matches the Subject header.",
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000]*$"
        },
        "since": {
          "description": "Messages on or after this date (YYYY-MM-DD).",
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "before": {
          "description": "Messages before this date (YYYY-MM-DD).",
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "unseen": {
          "description": "Only messages not yet read.",
          "type": "boolean"
        },
        "limit": {
          "description": "The most messages returned, newest first; 20 when not given.",
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      }
    },
    "args.gmail.read": {
      "description": "gmail.read: one message, by Gmail's message id, as text, with its attachments' names, types and sizes only (spec/PROTOCOL.md section 10; decisions/0003).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential",
        "id"
      ],
      "properties": {
        "credential": {
          "description": "The credential's name; the host uses the one it stores as gmail/<credential>.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "id": {
          "description": "Gmail's message id (X-GM-MSGID), a decimal integer, as gmail.search gives it.",
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[1-9][0-9]{0,19}$"
        }
      }
    },
    "request.host.describe": {
      "description": "A request for host.describe.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "dir",
        "job_id",
        "op",
        "args",
        "not_after"
      ],
      "properties": {
        "v": {
          "$ref": "#/$defs/v"
        },
        "dir": {
          "$ref": "#/$defs/dir",
          "const": "request"
        },
        "job_id": {
          "$ref": "#/$defs/job_id"
        },
        "op": {
          "$ref": "#/$defs/op_name",
          "const": "host.describe"
        },
        "args": {
          "$ref": "#/$defs/args.host.describe"
        },
        "not_after": {
          "$ref": "#/$defs/not_after"
        },
        "caps": {
          "$ref": "#/$defs/caps"
        },
        "min_host_version": {
          "$ref": "#/$defs/min_host_version"
        }
      }
    },
    "request.host.sleep": {
      "description": "A request for host.sleep.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "dir",
        "job_id",
        "op",
        "args",
        "not_after"
      ],
      "properties": {
        "v": {
          "$ref": "#/$defs/v"
        },
        "dir": {
          "$ref": "#/$defs/dir",
          "const": "request"
        },
        "job_id": {
          "$ref": "#/$defs/job_id"
        },
        "op": {
          "$ref": "#/$defs/op_name",
          "const": "host.sleep"
        },
        "args": {
          "$ref": "#/$defs/args.host.sleep"
        },
        "not_after": {
          "$ref": "#/$defs/not_after"
        },
        "caps": {
          "$ref": "#/$defs/caps"
        },
        "min_host_version": {
          "$ref": "#/$defs/min_host_version"
        }
      }
    },
    "request.files.sha256": {
      "description": "A request for files.sha256.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "dir",
        "job_id",
        "op",
        "args",
        "not_after"
      ],
      "properties": {
        "v": {
          "$ref": "#/$defs/v"
        },
        "dir": {
          "$ref": "#/$defs/dir",
          "const": "request"
        },
        "job_id": {
          "$ref": "#/$defs/job_id"
        },
        "op": {
          "$ref": "#/$defs/op_name",
          "const": "files.sha256"
        },
        "args": {
          "$ref": "#/$defs/args.files.sha256"
        },
        "not_after": {
          "$ref": "#/$defs/not_after"
        },
        "caps": {
          "$ref": "#/$defs/caps"
        },
        "min_host_version": {
          "$ref": "#/$defs/min_host_version"
        }
      }
    },
    "request.files.search": {
      "description": "A request for files.search.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "dir",
        "job_id",
        "op",
        "args",
        "not_after"
      ],
      "properties": {
        "v": {
          "$ref": "#/$defs/v"
        },
        "dir": {
          "$ref": "#/$defs/dir",
          "const": "request"
        },
        "job_id": {
          "$ref": "#/$defs/job_id"
        },
        "op": {
          "$ref": "#/$defs/op_name",
          "const": "files.search"
        },
        "args": {
          "$ref": "#/$defs/args.files.search"
        },
        "not_after": {
          "$ref": "#/$defs/not_after"
        },
        "caps": {
          "$ref": "#/$defs/caps"
        },
        "min_host_version": {
          "$ref": "#/$defs/min_host_version"
        }
      }
    },
    "request.github.read": {
      "description": "A request for github.read.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "dir",
        "job_id",
        "op",
        "args",
        "not_after"
      ],
      "properties": {
        "v": {
          "$ref": "#/$defs/v"
        },
        "dir": {
          "$ref": "#/$defs/dir",
          "const": "request"
        },
        "job_id": {
          "$ref": "#/$defs/job_id"
        },
        "op": {
          "$ref": "#/$defs/op_name",
          "const": "github.read"
        },
        "args": {
