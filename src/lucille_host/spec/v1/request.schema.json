          "const": "request"
        },
        "job_id": {
          "$ref": "#/$defs/job_id"
        },
        "op": {
          "$ref": "#/$defs/op_name",
          "const": "gmail.check"
        },
        "args": {
          "$ref": "#/$defs/args.gmail.check"
        },
        "not_after": {
          "$ref": "#/$defs/not_after"
        },
        "caps": {
          "$ref": "#/$defs/caps"
        },
