{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gald33/lucille-host/blob/main/src/lucille_host/spec/cli/v1/credential_removed.schema.json",
  "title": "lucille-host --json: credential_removed",
  "description": "A credential deleted from this computer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "service",
    "name"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "type": {
      "const": "credential_removed"
    },
    "service": {
      "$ref": "#/$defs/name"
    },
    "name": {
      "$ref": "#/$defs/name"
    }
  },
  "$defs": {
    "name": {
      "description": "A service's or a credential's name: 1 to 64 characters of a-z, 0-9, '.', '_' and '-', starting with a letter or a digit.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    }
  }
}
