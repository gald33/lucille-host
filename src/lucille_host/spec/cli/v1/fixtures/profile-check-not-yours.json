{
  "description": "profile check of a profile whose policy file and state folder root owns (uid 0), the user being uid 1000",
  "argv": [
    "--json",
    "profile",
    "check"
  ],
  "exit": 0,
  "stdout": [
    {
      "v": 1,
      "type": "profile_check",
      "state": "not_yours",
      "path": "/home/me/.config/lucille-host/default/policy.toml",
      "kind": "file",
      "uid": 0,
      "look": "(cd -P '/home/me/.config/lucille-host/default' && [ \"$(pwd -P)\" = '/home/me/.config/lucille-host/default' ] && ls -l './policy.toml')",
      "repair": "(cd -P '/home/me/.config/lucille-host/default' && [ \"$(pwd -P)\" = '/home/me/.config/lucille-host/default' ] && chown 1000 './policy.toml')"
    },
    {
      "v": 1,
      "type": "profile_check",
      "state": "not_yours",
      "path": "/home/me/.local/state/lucille-host/default",
      "kind": "folder",
      "uid": 0,
      "look": "(cd -P '/home/me/.local/state/lucille-host' && [ \"$(pwd -P)\" = '/home/me/.local/state/lucille-host' ] && ls -lR './default')",
      "repair": "(cd -P '/home/me/.local/state/lucille-host' && [ \"$(pwd -P)\" = '/home/me/.local/state/lucille-host' ] && chown -R 1000 './default')"
    }
  ]
}
