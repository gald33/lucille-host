{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gald33/lucille-host/blob/main/src/lucille_host/spec/cli/v1/credential_test.schema.json",
  "title": "lucille-host --json: credential_test",
  "description": "A credential that signed in to its service and out again, reading nothing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "service",
    "name",
    "host"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "type": {
      "const": "credential_test"
    },
    "service": {
      "$ref": "#/$defs/name"
    },
    "name": {
      "$ref": "#/$defs/name"
    },
    "host": {
      "$ref": "#/$defs/host"
    }
  },
  "$defs": {
    "name": {
      "description": "A service's or a credential's name: 1 to 64 characters of a-z, 0-9, '.', '_' and '-', starting with a letter or a digit.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "host": {
      "description": "A host a credential may be sent to: a DNS name of two labels or more, lowercase ASCII, no port, no IP address.",
      "type": "string",
      "minLength": 4,
      "maxLength": 253,
      "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]([a-z0-9-]{0,61}[a-z0-9])?$"
    }
  }
}
