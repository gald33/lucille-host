{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gald33/lucille-host/blob/main/src/lucille_host/spec/cli/v1/credential_answer.schema.json",
  "title": "lucille-host --json: credential_answer",
  "description": "The user's answer to one of Lucille's asks: saved, with the credential bound to the ask's hosts, or declined. Never a value.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "id",
    "service",
    "name",
    "answer"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "type": {
      "const": "credential_answer"
    },
    "id": {
      "$ref": "#/$defs/ask_id"
    },
    "service": {
      "$ref": "#/$defs/service"
    },
    "name": {
      "$ref": "#/$defs/name"
    },
    "answer": {
      "type": "string",
      "enum": [
        "saved",
        "declined"
      ]
    }
  },
  "$defs": {
    "ask_id": {
      "description": "An ask's id: 16 digits of 0-9 and a-f.",
      "type": "string",
      "minLength": 16,
      "maxLength": 16,
      "pattern": "^[0-9a-f]{16}$"
    },
    "service": {
      "description": "A service the host has a template for.",
      "type": "string",
      "enum": [
        "github",
        "gmail"
      ]
    },
    "name": {
      "description": "A service's or a credential's name: 1 to 64 characters of a-z, 0-9, '.', '_' and '-', starting with a letter or a digit.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    }
  }
}
