{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gald33/lucille-host/blob/main/src/lucille_host/spec/cli/v1/pair.schema.json",
  "title": "lucille-host --json: pair",
  "description": "Where the pairing is.",
  "oneOf": [
    {
      "$ref": "#/$defs/pair.none"
    },
    {
      "$ref": "#/$defs/pair.accepted"
    },
    {
      "$ref": "#/$defs/pair.waiting"
    },
    {
      "$ref": "#/$defs/pair.sas_pending"
    },
    {
      "$ref": "#/$defs/pair.confirmed"
    },
    {
      "$ref": "#/$defs/pair.rejected"
    }
  ],
  "$defs": {
    "time": {
      "description": "A time, UTC, ISO 8601, to the second.",
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "pair_name": {
      "description": "A pair's name.",
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "sas": {
      "description": "The pair's short authentication string, as Lucille's page shows it.",
      "type": "string",
      "minLength": 9,
      "maxLength": 9,
      "pattern": "^[0-9]{4}-[0-9]{4}$"
    },
    "pair.none": {
      "description": "This computer holds no pair.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "state"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "pair"
        },
        "state": {
          "const": "none"
        }
      }
    },
    "pair.accepted": {
      "description": "The code was answered.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "state",
        "name",
        "clock_skewed"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "pair"
        },
        "state": {
          "const": "accepted"
        },
        "name": {
          "$ref": "#/$defs/pair_name"
        },
        "clock_skewed": {
          "type": "boolean"
        }
      }
    },
    "pair.waiting": {
      "description": "No resolve has seen Lucille collect this computer's answer: Lucille has not collected it, or the hub could not be reached to ask.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "state",
        "name"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "pair"
        },
        "state": {
          "const": "waiting"
        },
        "name": {
          "$ref": "#/$defs/pair_name"
        }
      }
    },
    "pair.sas_pending": {
      "description": "The SAS is shown, and waits to be confirmed by the deadline.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "state",
        "name",
        "sas",
        "deadline"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "pair"
        },
        "state": {
          "const": "sas_pending"
        },
        "name": {
          "$ref": "#/$defs/pair_name"
        },
        "sas": {
          "$ref": "#/$defs/sas"
        },
        "deadline": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "pair.confirmed": {
      "description": "The local gate is open.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "state",
        "name"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "pair"
        },
        "state": {
          "const": "confirmed"
        },
        "name": {
          "$ref": "#/$defs/pair_name"
        }
      }
    },
    "pair.rejected": {
      "description": "The pair was forgotten here, unconfirmed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "state",
        "name",
        "lucille_told"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "pair"
        },
        "state": {
          "const": "rejected"
        },
        "name": {
          "$ref": "#/$defs/pair_name"
        },
        "lucille_told": {
          "type": "boolean"
        }
      }
    }
  }
}
