{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gald33/lucille-host/blob/main/src/lucille_host/spec/cli/v1/root_removed.schema.json",
  "title": "lucille-host --json: root_removed",
  "description": "A folder alias taken out of the local policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "alias"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "type": {
      "const": "root_removed"
    },
    "alias": {
      "$ref": "#/$defs/root"
    }
  },
  "$defs": {
    "root": {
      "description": "A folder alias from the host's local policy. Never a path.",
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    }
  }
}
