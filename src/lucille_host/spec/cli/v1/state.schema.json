{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gald33/lucille-host/blob/main/src/lucille_host/spec/cli/v1/state.schema.json",
  "title": "lucille-host --json: state",
  "description": "What a running run sees now: written when it changes, and at least every 60 s.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "pair",
    "confirmed",
    "paused",
    "policy",
    "last_hub_contact",
    "clock",
    "rooms",
    "offers_waiting",
    "last_left_because"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "type": {
      "const": "state"
    },
    "pair": {
      "$ref": "#/$defs/pair_name"
    },
    "confirmed": {
      "type": "boolean"
    },
    "paused": {
      "type": "boolean"
    },
    "policy": {
      "type": "string",
      "enum": [
        "ok",
        "invalid",
        "checking"
      ]
    },
    "last_hub_contact": {
      "oneOf": [
        {
          "$ref": "#/$defs/time"
        },
        {
          "type": "null"
        }
      ]
    },
    "clock": {
      "oneOf": [
        {
          "$ref": "#/$defs/clock.ok"
        },
        {
          "$ref": "#/$defs/clock.skewed"
        },
        {
          "$ref": "#/$defs/clock.unknown"
        }
      ]
    },
    "rooms": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/room.reading"
          },
          {
            "$ref": "#/$defs/room.read_stuck"
          }
        ]
      }
    },
    "offers_waiting": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "last_left_because": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "check_3",
            "check_4",
            "left_before"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "pair_name": {
      "description": "A pair's name.",
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "room_name": {
      "description": "The host's own name for a work room it holds.",
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "time": {
      "description": "A time, UTC, ISO 8601, to the second.",
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "clock.ok": {
      "description": "Measured on the last reply posted; positive when this computer is behind the hub.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "skew_s"
      ],
      "properties": {
        "state": {
          "const": "ok"
        },
        "skew_s": {
          "type": "number"
        }
      }
    },
    "clock.skewed": {
      "description": "The hub refuses what the host writes: this computer's clock is more than 300 s off.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "skew_s"
      ],
      "properties": {
        "state": {
          "const": "skewed"
        },
        "skew_s": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "clock.unknown": {
      "description": "Not measured yet.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "const": "unknown"
        }
      }
    },
    "room.reading": {
      "description": "run reads it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "state"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/room_name"
        },
        "state": {
          "const": "reading"
        }
      }
    },
    "room.read_stuck": {
      "description": "A message there cannot be opened, and run reads no further there.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "state"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/room_name"
        },
        "state": {
          "const": "read_stuck"
        }
      }
    }
  }
}
